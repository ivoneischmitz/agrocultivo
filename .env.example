# Copie para .env e preencha com os dados do projeto Supabase
# (Project Settings > API). O prefixo EXPO_PUBLIC_ faz o Expo embutir os
# valores no app para web, iOS e Android.
EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key

# Endereço do app publicado na web (Vercel), ex.: https://agrocultivo.vercel.app
# O link de "Esqueci minha senha" pedido pelo celular abre nesse site.
EXPO_PUBLIC_SITE_URL=
